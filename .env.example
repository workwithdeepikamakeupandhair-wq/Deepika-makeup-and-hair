# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres connection string (Neon console -> Connect -> "Connection string").
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# OpenAI API key for the website chat assistant (https://platform.openai.com/api-keys).
# Used only on the server, never sent to the browser.
# Leave empty to run the chat in search-only mode (returns the best matching answer).
OPENAI_API_KEY=""

# Optional: model for chat replies (default: gpt-5.4-mini).
# OPENAI_MODEL="gpt-5.4-mini"

# Port for the Express backend (the Vite dev server proxies /api to it).
PORT=4000

# ---------- WhatsApp bot (optional) ----------
# The website assistant also answers on WhatsApp when all four values below are set.
# Meta App Dashboard -> WhatsApp -> API Setup: the access token and "Phone number ID".
# (The token from "Generate token" expires after about 24 hours; for a lasting one, create a
#  System User token in Meta Business Settings with whatsapp_business_messaging permission.)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any secret phrase you make up; type the same phrase as "Verify token" in WhatsApp -> Configuration.
WHATSAPP_VERIFY_TOKEN=""
# App Dashboard -> App settings -> Basic -> App secret (used to check that webhooks really come from Meta).
WHATSAPP_APP_SECRET=""
# By default the bot has its OWN number, separate from Deepika's: it gives customers Deepika's own WhatsApp/phone
# for anything personal, and "Talk to Deepika" saves them as a lead in the dashboard.
# Set to true only if the bot answers on Deepika's own number via coexistence (she reads and replies to the chats).
# WHATSAPP_COEXISTENCE=false
# Coexistence only: after Deepika replies to a customer herself from the WhatsApp Business app,
# the bot stays quiet in that chat for this many hours (default 12).
# WHATSAPP_HUMAN_TAKEOVER_HOURS=12
# Optional: Graph API version (default v25.0).
# WHATSAPP_GRAPH_VERSION="v25.0"

# ---------- Leads dashboard (/admin) ----------
# Any long random text. Signs the login cookie. If empty, a key derived from DATABASE_URL is used instead
# (changing the database password then logs everyone out).
SESSION_SECRET=""

# ---------- Leads from Meta instant-form ads (optional) ----------
# A Page access token with leads_retrieval permission (System User token for the Facebook Page that runs the ads).
# Without it, ad leads are still saved with their lead ID, but without the person's answers.
META_PAGE_ACCESS_TOKEN=""
# Only if the Lead Ads webhook uses a different Meta app than WhatsApp (defaults to the WhatsApp values):
# META_APP_SECRET=""
# META_VERIFY_TOKEN=""
